{
  "name": "narrative-motion-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx scripts/cli.ts dev",
    "new:project": "tsx scripts/cli.ts new",
    "audio:ingest": "tsx scripts/cli.ts audio",
    "assets:check": "tsx scripts/cli.ts assets",
    "render:frame": "tsx scripts/cli.ts frame",
    "render:range": "tsx scripts/cli.ts range",
    "render:contact": "tsx scripts/cli.ts contact",
    "render:draft": "tsx scripts/cli.ts draft",
    "render:final": "tsx scripts/cli.ts final",
    "qa": "tsx scripts/cli.ts qa",
    "sources": "tsx scripts/cli.ts sources",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "tsx scripts/integration.ts",
    "test:gallery": "tsx scripts/integration-gallery.ts",
    "test:preview": "npm run build && tsx scripts/verify-preview.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm test",
    "build": "vite build"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "@fontsource/barlow-condensed": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "d3-geo": "^3.1.1",
    "playwright": "^1.55.0",
    "sharp": "^0.35.5",
    "three": "^0.180.0",
    "topojson-client": "^3.1.0",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.18.0",
    "@types/three": "^0.180.0",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.5",
    "vitest": "^4.1.11"
  }
}
